---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found | Book BASI" description="The requested page could not be found." noindex>
  <section class="not-found section-dark">
    <div class="container container-narrow">
      <p class="eyebrow">404</p>
      <h1>This page is not part of the foundation.</h1>
      <p>The address may have changed or the page may no longer exist.</p>
      <a class="button button-gold" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
