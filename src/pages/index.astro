---
import ActionList from '@/components/ActionList.astro'
import CTASection from '@/components/CTASection.astro'
import FeaturedWork from '@/components/FeaturedWork.astro'
import Hero from '@/components/Hero.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {getActions, getHomePage, getSiteSettings, getTestimonials} from '@/lib/content'

const [home, actions, settings, testimonials] = await Promise.all([
  getHomePage(),
  getActions(),
  getSiteSettings(),
  getTestimonials(),
])

const primaryCta = home.primaryCta
const portfolioAction = actions.find((action) => action._id === 'action.view-work' || action.title === 'View Work')
const contactAction = actions.find((action) => action._id === 'action.contact-basi' || action.title === 'Contact BASI')
const serviceNames = ['Events', 'Headshots', 'Branding', 'Portraits']
---

<BaseLayout
  title={home.seoTitle || settings.defaultSeoTitle}
  description={home.seoDescription || settings.defaultSeoDescription}
  canonical="/"
>
  <Hero
    eyebrow={home.eyebrow}
    headline={home.headline}
    copy={home.supportingCopy}
    primaryCta={primaryCta}
    secondaryCta={home.secondaryCta}
    services={serviceNames}
    serviceArea={settings.serviceArea}
    image={home.heroImage}
  />

  <ActionList
    {actions}
    eyebrow={home.chooserEyebrow}
    heading={home.chooserHeading}
    copy={home.chooserCopy}
  />

  {home.showWork && (
    <FeaturedWork
      heading={home.workHeading}
      copy={home.workCopy}
      images={home.selectedWork}
      instagramUrl={settings.instagramUrl}
      portfolioUrl={portfolioAction?.url || 'https://everythingbasi.com/portfolio/'}
    />
  )}

  {home.showTrust && (
    <section class="section value-section" id="why-basi" aria-labelledby="value-title">
      <div class="container">
        <div class="value-intro">
          <div>
            <p class="eyebrow">{home.trustHeading}</p>
            <h2 id="value-title">{home.presenceStatement}</h2>
            <p class="value-support">{home.trustCopy}</p>
          </div>
        </div>
        <div class="value-grid">
          {home.trustPoints.map((point, index) => (
            <article>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </article>
          ))}
        </div>
        {home.showTestimonials && testimonials.length > 0 && (
          <div class="testimonial-list value-testimonials" aria-labelledby="proof-title">
            <h3 id="proof-title">Client perspective</h3>
            {testimonials.map((item) => (
              <figure>
                <blockquote>“{item.quote}”</blockquote>
                <figcaption>{item.name}{item.context && ` — ${item.context}`}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <CTASection
    heading={home.closingHeading}
    copy={home.closingCopy}
    label={home.closingCta.label}
    destination={home.closingCta.destination}
    secondaryLabel={contactAction?.title || 'Contact BASI'}
    secondaryDestination={contactAction?.url || 'https://everythingbasi.com/contact/'}
    {settings}
  />
</BaseLayout>
