---
import ActionList from '@/components/ActionList.astro'
import CTASection from '@/components/CTASection.astro'
import FeaturedWork from '@/components/FeaturedWork.astro'
import Hero from '@/components/Hero.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import ServiceCard from '@/components/ServiceCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {getActions, getHomePage, getServices, getSiteSettings, getTestimonials} from '@/lib/content'

const [home, actions, services, settings, testimonials] = await Promise.all([
  getHomePage(),
  getActions(),
  getServices(),
  getSiteSettings(),
  getTestimonials(),
])

const eventService = services.find((service) => service.slug === 'event-coverage')
const headshotService = services.find((service) => service.slug === 'team-headshots')
const brandingService = services.find((service) => service.slug === 'personal-branding')
const portraitServices = services.filter((service) => ['studio-portraits', 'outdoor-portraits'].includes(service.slug))
const primaryCta = {...home.primaryCta, destination: settings.bookingDestination, label: settings.primaryCta.label}
const serviceNames = ['Events', 'Headshots', 'Branding', 'Portraits']
---

<BaseLayout
  title={home.seoTitle || settings.defaultSeoTitle}
  description={home.seoDescription || settings.defaultSeoDescription}
  canonical="/"
>
  <Hero
    eyebrow={home.eyebrow}
    headline={home.headline}
    copy={home.supportingCopy}
    primaryCta={primaryCta}
    secondaryCta={home.secondaryCta}
    services={serviceNames}
    serviceArea={settings.serviceArea}
    image={home.heroImage}
  />

  <ActionList {actions} eyebrow={home.chooserEyebrow} heading={home.chooserHeading} />

  <section class="section service-details" id="services" aria-labelledby="services-title">
    <div class="container">
      <SectionHeading
        eyebrow={home.servicesEyebrow}
        title={home.servicesHeading}
        copy={home.introduction}
        id="services-title"
      />
      <div class="service-detail-grid">
        {eventService && <ServiceCard service={eventService} id="events" tier="primary" bookingDestination={settings.bookingDestination} />}
        {headshotService && <ServiceCard service={headshotService} id="headshots" tier="secondary" bookingDestination={settings.bookingDestination} />}
        {brandingService && <ServiceCard service={brandingService} id="branding" bookingDestination={settings.bookingDestination} />}
        {portraitServices.length > 0 && (
          <section class="portrait-card" id="portraits" aria-labelledby="portraits-title">
            <div class="portrait-card-heading">
              <p class="service-category">Portraits</p>
              <h3 id="portraits-title">Portrait Sessions</h3>
              <p>Studio and outdoor options built around how you want to show up.</p>
            </div>
            <div class="portrait-options">
              {portraitServices.map((service) => <ServiceCard {service} bookingDestination={settings.bookingDestination} compact />)}
            </div>
          </section>
        )}
      </div>
    </div>
  </section>

  {home.showWork && (
    <FeaturedWork
      heading={home.workHeading}
      copy={home.workCopy}
      images={home.selectedWork}
      instagramUrl={settings.instagramUrl}
    />
  )}

  {home.showTrust && (
    <section class="section value-section" id="why-basi" aria-labelledby="value-title">
      <div class="container">
        <div class="value-intro">
          <div>
            <p class="eyebrow">BASI means foundation</p>
            <h2 id="value-title">{home.presenceStatement}</h2>
          </div>
          <div class="value-process">
            <p class="eyebrow">Why BASI</p>
            <h3>{home.trustHeading}</h3>
            <p>{home.trustCopy}</p>
          </div>
        </div>
        <div class="value-grid">
          {home.trustPoints.map((point, index) => (
            <article>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </article>
          ))}
        </div>
        {home.showTestimonials && testimonials.length > 0 && (
          <div class="testimonial-list value-testimonials" aria-labelledby="proof-title">
            <h3 id="proof-title">Client perspective</h3>
            {testimonials.map((item) => (
              <figure>
                <blockquote>“{item.quote}”</blockquote>
                <figcaption>{item.name}{item.context && ` — ${item.context}`}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <CTASection
    heading={home.closingHeading}
    copy={home.closingCopy}
    label={settings.primaryCta.label}
    destination={settings.bookingDestination}
    contactHeading={home.contactHeading}
    contactCopy={home.contactCopy}
    {settings}
  />
</BaseLayout>
