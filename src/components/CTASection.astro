---
import type {SiteSettings} from '@/types/content'

interface Props {
  heading: string
  copy: string
  label: string
  destination: string
  secondaryLabel: string
  secondaryDestination: string
  settings: SiteSettings
}

const {heading, copy, label, destination, secondaryLabel, secondaryDestination, settings} = Astro.props
---

<section class="cta-section section-gold" id="contact" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-inner">
      <div>
        <p class="eyebrow">Book BASI</p>
        <h2 id="cta-title">{heading}</h2>
        <p>{copy}</p>
      </div>
      <div class="cta-actions">
        <a class="button button-dark" href={destination}>{label}</a>
        <a class="button button-outline-dark" href={secondaryDestination} data-action="contact-basi">{secondaryLabel}</a>
      </div>
    </div>
    <div class="conversion-meta" aria-label="BASI contact details">
      <a href={`mailto:${settings.email}`}>{settings.email}</a>
      {settings.instagramUrl && <a href={settings.instagramUrl} target="_blank" rel="noopener">@book.basi</a>}
      {settings.serviceArea && <span>{settings.serviceArea}</span>}
    </div>
  </div>
</section>
