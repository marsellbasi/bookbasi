---
import Logo from '@/components/Logo.astro'
import type {SiteSettings} from '@/types/content'

interface Props {
  settings: SiteSettings
}

const {settings} = Astro.props
const onHomePage = Astro.url.pathname === '/'
const bookingDestination = settings.primaryCta.destination
const bookingHref = bookingDestination.startsWith('#') && !onHomePage ? `/${bookingDestination}` : bookingDestination
const servicesHref = onHomePage ? '#services' : '/#services'
const workHref = onHomePage ? '#work' : '/#work'
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand-link" href="/" aria-label="Book BASI home">
      <Logo priority />
      <span>Book BASI</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={servicesHref}>Services</a>
      <a href={workHref}>Work</a>
      <a class="nav-cta" href={bookingHref}>{settings.primaryCta.label}</a>
    </nav>
  </div>
</header>
