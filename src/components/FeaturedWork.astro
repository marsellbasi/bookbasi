---
import SectionHeading from '@/components/SectionHeading.astro'
import {sanityImageUrl, workImageRatio} from '@/lib/images'
import type {HomepageServiceCard, WorkImage} from '@/types/content'

interface Props {
  heading: string
  copy: string
  images: WorkImage[]
  serviceCards?: HomepageServiceCard[]
  instagramUrl?: string
  portfolioUrl: string
}

const {heading, copy, images, serviceCards = [], instagramUrl, portfolioUrl} = Astro.props

type WorkCategory = NonNullable<WorkImage['category']>

const categoryLabels: Record<WorkCategory, string> = {
  events: 'Event Coverage',
  headshots: 'Team Headshots',
  branding: 'Personal Branding',
  portraits: 'Portraits',
}

// Category destinations follow the CMS-managed service cards; these are the reviewed build-failure fallbacks.
const categoryCardKeys: Record<WorkCategory, string> = {
  events: 'event-coverage',
  headshots: 'team-headshots',
  branding: 'personal-branding',
  portraits: 'portrait-sessions',
}

const fallbackCategoryUrls: Record<WorkCategory, string> = {
  events: 'https://everythingbasi.com/events/',
  headshots: 'https://everythingbasi.com/atlanta-business-headshots/',
  branding: 'https://everythingbasi.com/book/branding/',
  portraits: 'https://everythingbasi.com/portraits/',
}

const categoryUrl = (category: WorkCategory) =>
  serviceCards.find((card) => card._key === categoryCardKeys[category])?.ctaUrl || fallbackCategoryUrls[category]
---

<section class:list={['section', 'work-section', 'section-dark', images.length === 0 && 'work-section-empty']} id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="work-heading-row">
      <SectionHeading eyebrow="Featured work" title={heading} copy={copy} id="work-title" />
      <div class="work-actions">
        <a class="text-link work-portfolio" href={portfolioUrl} data-action="view-work">View Full Portfolio <span aria-hidden="true">→</span></a>
        {images.length === 0 && instagramUrl && <a class="text-link work-instagram" href={instagramUrl} target="_blank" rel="noopener">View recent work on Instagram <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
    {images.length > 0 && (
      <div class="work-grid">
        {images.map((image, index) => {
          const ratio = workImageRatio(image, index)
          const imageHeight = (width: number) => Math.round(width * ratio.height / ratio.width)
          const sizes = index === 0
            ? '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 50vw'
            : index === images.length - 1
              ? '(max-width: 640px) 100vw, (max-width: 959px) 25vw, 50vw'
              : '(max-width: 640px) 50vw, (max-width: 1024px) 50vw, 25vw'
          const category = image.category
          const Frame = category ? 'a' : 'div'
          const frameProps = category
            ? {href: categoryUrl(category), 'aria-label': `${categoryLabels[category]} — ${image.alt}`}
            : {}

          return (
            <figure class:list={['work-item', `work-item-${ratio.name}`, index === 0 && 'work-item-featured']}>
              <Frame class="work-item-frame" {...frameProps}>
                <img
                  src={sanityImageUrl(image, 960, imageHeight(960))}
                  srcset={`${sanityImageUrl(image, 480, imageHeight(480))} 480w, ${sanityImageUrl(image, 800, imageHeight(800))} 800w, ${sanityImageUrl(image, 1200, imageHeight(1200))} 1200w`}
                  sizes={sizes}
                  alt={image.alt}
                  width={ratio.width * 200}
                  height={ratio.height * 200}
                  loading="lazy"
                  decoding="async"
                />
                {category && <span class="work-item-category" aria-hidden="true">{categoryLabels[category]}</span>}
              </Frame>
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          )
        })}
      </div>
    )}
  </div>
</section>
