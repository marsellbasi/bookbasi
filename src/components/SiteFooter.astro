---
import Logo from '@/components/Logo.astro'
import type {SiteSettings} from '@/types/content'

interface Props {
  settings: SiteSettings
}

const {settings} = Astro.props
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="footer-brand" href="/" aria-label="Book BASI home"><Logo /></a>
    <div class="footer-identity">
      <p>{settings.footerText}</p>
      <a href={`mailto:${settings.email}`}>{settings.email}</a>
      {settings.serviceArea && <span>{settings.serviceArea}</span>}
    </div>
    <div class="footer-meta">
      <a href="/#services">Services</a>
      <a href="/#work">Work</a>
      <a href="/#contact">Contact</a>
      {settings.instagramUrl && <a href={settings.instagramUrl} target="_blank" rel="noopener">Instagram</a>}
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <small>© {year} BASI</small>
    </div>
  </div>
</footer>
