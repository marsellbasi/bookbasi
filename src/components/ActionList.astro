---
import ActionLink from '@/components/ActionLink.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import type {LinkAction} from '@/types/content'

interface Props {
  actions: LinkAction[]
}

const {actions} = Astro.props
---

<section class="section quick-actions" aria-labelledby="quick-actions-title">
  <div class="container container-narrow">
    <SectionHeading eyebrow="Start here" title="Choose your next step" id="quick-actions-title" />
    <div class="action-list">
      {actions.map((action) => <ActionLink action={action} />)}
    </div>
  </div>
</section>
