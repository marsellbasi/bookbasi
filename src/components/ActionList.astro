---
import ActionLink from '@/components/ActionLink.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import type {HomepageServiceCard, LinkAction} from '@/types/content'

interface Props {
  actions: LinkAction[]
  serviceCards: HomepageServiceCard[]
  eyebrow: string
  heading: string
  copy: string
}

const {actions, serviceCards, eyebrow, heading, copy} = Astro.props
const primaryActions: LinkAction[] = serviceCards.map((card, index) => ({
  _id: `action.${card._key}`,
  title: card.title,
  subtitle: card.description,
  ctaLabel: card.ctaLabel,
  url: card.ctaUrl,
  variant: index === 0 ? 'primary' : 'secondary',
  displayOrder: index,
}))
const utilityActions = actions.filter((action) => action.variant === 'quiet')
---

<section class="section quick-actions" id="services" aria-labelledby="quick-actions-title">
  <div class="container">
    <SectionHeading {eyebrow} title={heading} {copy} id="quick-actions-title" />
    <div class="action-list action-list-primary">
      {primaryActions.map((action) => <ActionLink action={action} />)}
    </div>
    {utilityActions.length > 0 && (
      <div class="action-list-utility" aria-label="More ways to connect">
        {utilityActions.map((action) => <ActionLink action={{...action, variant: 'quiet'}} />)}
      </div>
    )}
  </div>
</section>
