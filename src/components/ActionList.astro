---
import ActionLink from '@/components/ActionLink.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import type {LinkAction} from '@/types/content'

interface Props {
  actions: LinkAction[]
  eyebrow: string
  heading: string
}

const {actions, eyebrow, heading} = Astro.props
const primaryActions = actions.filter((action) => action.variant !== 'quiet').slice(0, 4)
const utilityActions = actions.filter((action) => action.variant === 'quiet')
---

<section class="section quick-actions" id="services" aria-labelledby="quick-actions-title">
  <div class="container">
    <SectionHeading {eyebrow} title={heading} id="quick-actions-title" />
    <div class="action-list action-list-primary">
      {primaryActions.map((action) => <ActionLink action={action} />)}
    </div>
    {utilityActions.length > 0 && (
      <div class="action-list-utility" aria-label="More ways to connect">
        {utilityActions.map((action) => <ActionLink action={{...action, variant: 'quiet'}} />)}
      </div>
    )}
  </div>
</section>
