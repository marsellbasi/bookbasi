---
import type {Service} from '@/types/content'

interface Props {
  service: Service
  id?: string
  tier?: 'primary' | 'secondary' | 'standard'
  bookingDestination: string
  compact?: boolean
}

const {service, id, tier = 'standard', bookingDestination, compact = false} = Astro.props
const details = [service.pricingLabel, service.duration, ...(service.deliverables || [])].filter(Boolean).slice(0, 4)
const destination = service.bookingUrl || bookingDestination
const Heading = compact ? 'h4' : 'h3'
---

<article id={id} class:list={['service-card', `service-card-${tier}`, compact && 'service-card-compact']}>
  <div class="service-card-copy">
    <p class="service-category">{service.category}</p>
    <Heading>{service.shortTitle || service.title}</Heading>
    <p>{service.shortDescription}</p>
  </div>
  {details.length > 0 && (
    <ul class="service-facts" aria-label={`${service.title} details`}>
      {details.map((detail) => <li>{detail}</li>)}
    </ul>
  )}
  <a class="text-link" href={destination} aria-label={`${service.bookingCtaLabel || 'Book BASI'} — ${service.title}`}>
    {service.bookingCtaLabel || 'Book BASI'} <span aria-hidden="true">→</span>
  </a>
</article>
